<?xml version="1.0" encoding="UTF-8"?>
<!--
  ZUEL 讲座雷达 —— 定时任务模板（macOS launchd）

  由 scripts/install_launchd.sh 安装到 ~/Library/LaunchAgents/ 并自动替换占位符：
    __PYTHON__  运行用的 Python 解释器绝对路径
    __PROJECT__ 项目根目录绝对路径
    __HOUR__    每天唤起的时刻（默认 20 = 晚上 20:00）
    __MINUTE__  分钟（默认 0）

  说明：调度器每天在固定时刻唤起一次，由 run.py due 逐用户判断
  「距上次推送是否已满 interval_days 天」，从而支持每个用户不同的间隔。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.zuel.lecture-radar</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__PROJECT__/run.py</string>
        <string>due</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT__</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>__HOUR__</integer>
        <key>Minute</key>
        <integer>__MINUTE__</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__PROJECT__/data/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT__/data/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>

    <!-- 错过时间（如休眠）后，开机/唤醒时补跑一次 -->
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
